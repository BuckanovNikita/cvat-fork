--- -q SELECT name, value, description FROM system.settings WHERE name ILIKE '%refresh%' FORMAT Vertical
Row 1:
──────
name:        max_live_view_insert_blocks_before_refresh
value:       64
description: Limit maximum number of inserted blocks after which mergeable blocks are dropped and query is re-executed.

Row 2:
──────
name:        periodic_live_view_refresh
value:       60
description: Interval after which periodically refreshed live view is forced to refresh.

--- -q SELECT name FROM system.tables WHERE database = 'system' AND name ILIKE '%refresh%'

--- -q CREATE TABLE IF NOT EXISTS rmv_target (user_id UInt64, working_ms UInt64) ENGINE = MergeTree ORDER BY user_id

--- -q CREATE MATERIALIZED VIEW rmv_test REFRESH EVERY 1 HOUR TO rmv_target AS SELECT ifNull(user_id, 0) AS user_id, sum(duration) AS working_ms FROM events WHERE scope = 'send:working_time' GROUP BY user_id
