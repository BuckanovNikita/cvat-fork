# Pinned inputs of the Team Analytics test stack. Sourced by run.sh; every value can be
# overridden from the environment.

# Raw upstream commit of cvat-ai/cvat tag v2.82.0 (docs/evidence/2026-11-13-fork-baseline.md).
# The chart comes from this commit, not from the fork's filtered import under cvat/.
: "${TA_UPSTREAM_COMMIT:=02bd74fde78e00f770b7dfc3c33761ad9ab00095}"
: "${TA_UPSTREAM_ARCHIVE_URL:=https://codeload.github.com/cvat-ai/cvat/tar.gz/${TA_UPSTREAM_COMMIT}}"

# Chart cache, outside the repository.
: "${TA_CACHE_DIR:=${XDG_CACHE_HOME:-$HOME/.cache}/cvat-fork/team-analytics}"

# Cluster and namespace. The namespace name is project specific; TA_RUN_ID lets several
# runs coexist (default: one stack per machine user).
: "${TA_KUBE_CONTEXT:=docker-desktop}"
: "${TA_RUN_ID:=${USER:-local}}"
: "${TA_NAMESPACE:=cvat-ta-it-${TA_RUN_ID}}"
: "${TA_RELEASE:=cvat}"

# Host port reserved for this stack in the k8s-infra host port table (8490).
: "${TA_HOST_PORT:=8490}"

# Images. The UI image must include the Team Analytics page of the checkout under test
# (IMAGE=cvat/ui:v2.82.0-team-analytics ./build-ui.sh); the page check fails on an older
# build. It must be present locally (no pull).
: "${TA_UI_IMAGE:=cvat/ui:v2.82.0-team-analytics}"
: "${TA_PROXY_IMAGE:=nginx:1.27-alpine}"
# Team Analytics service image (build-team-analytics-service.sh); local only, never pulled.
: "${TA_SERVICE_IMAGE:=cvat/team-analytics:v2.82.0}"
# Refresh interval of the service on the stack, short so a scheduled refresh is seen soon.
: "${TA_REFRESH_INTERVAL_S:=60}"
# Headless browser for the page check (google-chrome or chromium).
: "${TA_BROWSER_BIN:=google-chrome}"

# Images run.sh may pull, one at a time, when missing locally (owner-approved list in the
# Team Analytics spec, "Further Notes"). Every other image of the stack must already be
# local; run.sh refuses to install otherwise.
TA_APPROVED_PULLS="cvat/server:v2.82.0 apache/kvrocks:2.15.0 cvat/clickhouse:23.12.2-debian-11-r0 cvat/postgresql:15.2.0-debian-11-r0 redis:7.2.11 grafana/grafana:10.1.5 busybox:1.36.1"

# A namespace older than this is recreated before use, so a run never starts close to the
# cluster sweeper's 48-hour limit.
: "${TA_MAX_REUSE_HOURS:=36}"

# Password of every seeded account (disposable stack only).
: "${TA_SEED_PASSWORD:=ta-Stack-pass-1}"
