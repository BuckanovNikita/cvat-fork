# Pinned inputs of the Team Analytics test stack. Sourced by run.sh; every value can be
# overridden from the environment.

# The chart is the tree's (helm-chart); its dependency versions are pinned by Chart.lock
# and chart-deps.sha256 beside this file.
# Working directory outside the repository: the chart build with its dependency archives, the
# helm repository index cache and the port-forward state.
: "${TA_CACHE_DIR:=${XDG_CACHE_HOME:-$HOME/.cache}/cvat-fork/team-analytics}"

# Cluster and namespace. The namespace name is project specific; TA_RUN_ID lets several
# runs coexist (default: one stack per machine user).
: "${TA_KUBE_CONTEXT:=docker-desktop}"
: "${TA_RUN_ID:=${USER:-local}}"
: "${TA_NAMESPACE:=cvat-ta-it-${TA_RUN_ID}}"
: "${TA_RELEASE:=cvat}"

# Host port of the stack's address, reserved in the k8s-infra host port table: 8490 for the default
# stack, 8491 for a second stack of the same user (with its own TA_RUN_ID). A port in use is refused.
: "${TA_HOST_PORT:=8490}"

# Images. The backend (server, every worker including the Team Analytics worker, the initializer)
# runs the fork server image (ADR 0006 and 0007): a full build of the tree by ./build-server.sh
# from public bases (python:3.12-slim-bookworm, Debian 12). It must be present locally and is never
# pulled; up and preflight stop first thing without it, and check that it is Debian 12 with
# python3 3.12 and that its policy bundles carry the tree's policies.
: "${TA_SERVER_IMAGE:=cvat/server:v2.82.0-fork}"
# The UI image must include the Team Analytics page of the checkout under test (./build-ui.sh);
# the page check fails on an older build. It must be present locally (no pull).
: "${TA_UI_IMAGE:=cvat/ui:v2.82.0-fork}"
: "${TA_PROXY_IMAGE:=nginx:1.27-alpine}"
# Settings of the Team Analytics app on the stack (environment of every backend pod, through the
# chart's cvat.backend.additionalEnv): a refresh interval short enough that a scheduled refresh is
# seen soon.
: "${TA_REFRESH_INTERVAL_S:=60}"
# The Technical accounts list the seed sets through the settings API (user names, separated by commas
# or spaces; empty for none): the final run's ta-bot, which saves boxes as a script would.
: "${TA_TECHNICAL_ACCOUNTS:=ta-bot}"
# Headless browser for the page check (google-chrome or chromium).
: "${TA_BROWSER_BIN:=google-chrome}"

# Images run.sh may pull, one at a time, when missing locally (owner-approved list in the
# Team Analytics spec, "Further Notes"). Every other image of the stack must already be
# local; run.sh refuses to install otherwise. The stock server image cvat/server:v2.82.0 is
# not among them (the fork server image no longer starts from it), and run.sh refuses a render
# that names it. The build's own bases are pulled by build-server.sh, not by run.sh.
TA_APPROVED_PULLS="apache/kvrocks:2.15.0 cvat/clickhouse:23.12.2-debian-11-r0 cvat/postgresql:15.2.0-debian-11-r0 redis:7.2.11 grafana/grafana:10.1.5 busybox:1.36.1"
# Images of the chart that must already be local and are never pulled. With the approved pulls
# and the three images named above, they are the whole list of images a render may name.
TA_LOCAL_IMAGES="openpolicyagent/opa:1.12.2 timberio/vector:0.26.0-alpine"

# A namespace older than this is recreated before use, so a run never starts close to the
# cluster sweeper's 48-hour limit.
: "${TA_MAX_REUSE_HOURS:=36}"


# Password of every seeded account (disposable stack only).
: "${TA_SEED_PASSWORD:=ta-Stack-pass-1}"
