cvat-ui-*.tar.gz
.cvat-mirror.git*/
cvat/.yarn/
cvat/**/node_modules/
cvat/cvat-ui/dist/*
!cvat/cvat-ui/dist/favicon.ico

# Python bytecode (seam 1 and stack scripts)
__pycache__/
*.pyc

# Dependencies of the frontend harness (verify/package.json). No trailing slash:
# a worktree's link to an installed copy is ignored as well as the directory.
/verify/node_modules

# Environment and cache of the check pipeline's Python tools (pyproject.toml, prek.toml)
/.venv/
.ruff_cache/
