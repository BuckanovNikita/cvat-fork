# Fork server image (ADR 0007): the whole CVAT backend built from the fork's tree on public bases,
# Debian 12 with Python 3.12 from the official Python image. It ports upstream's Dockerfile, which
# stays as upstream wrote it, stage by stage: the build base, OpenH264 + FFmpeg + PyAV, the other
# wheels, smokescreen, the runtime. Where this file differs from it, a comment says why: package
# names that differ between Ubuntu 24.04 and Debian 12, Rust 1.85 from the Rust image, Python and
# its headers, pip and venv from the base instead of apt.
#
# It deliberately needs no external Dockerfile frontend image: upstream's `# syntax=` line is left
# out and its one COPY --parents is written as plain COPY instructions with explicit destinations,
# so the frontend built into the Docker installation's BuildKit builds it (RUN --mount needs
# BuildKit; the legacy builder cannot build this file).
#
# Built by build-server.sh, which gives it a context of the tracked files it copies, refuses a
# base that is not pinned by digest, and refuses to build when upstream's Dockerfile changed since this port
# (docs/upstream-upgrade.md, section 3). The server and every worker run this one image.

# python:3.12-slim-bookworm
ARG BASE_IMAGE=python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
# rust:1.85-slim-bookworm
ARG RUST_IMAGE=rust:1.85-slim-bookworm@sha256:9f841bbe9e7d8e37ceb96ed907265a3a0df7f44e3737d0b100e7907a679acb36
# golang:1.27.2, the tag upstream's smokescreen stage names
ARG GOLANG_IMAGE=golang:1.27.2@sha256:820153096fda4de6ac1b7194d12e416b7dd8f4e9a33d17e0345b111b945162d8

# Upstream takes Rust 1.85 from Ubuntu's cargo-1.85 package. Debian 12's cargo is far older, so
# the toolchain comes from the Rust image, built on the same Debian release. Datumaro's wheel
# (a source archive in the requirements) builds a Rust extension.
FROM ${RUST_IMAGE} AS rust-toolchain

FROM ${BASE_IMAGE} AS build-image-base

# Upstream's python3-dev and python3-pip are left out: the base provides Python 3.12 with its
# headers and pip under /usr/local, and Debian's packages would bring Debian's Python 3.11.
# libldap-dev is Debian's name for Ubuntu's libldap2-dev.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get --no-install-recommends install -yq \
        curl \
        g++ \
        gcc \
        git \
        libhdf5-dev \
        libldap-dev \
        libmp3lame-dev \
        libsasl2-dev \
        make \
        nasm \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:${PATH}

ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Parallel jobs of each compiler step (upstream's fixed make -j5). The FFmpeg, wheel and Go stages
# run at the same time, so the build can use several times this many cores.
ARG MAKE_JOBS=5
ENV CARGO_BUILD_JOBS=${MAKE_JOBS}

# We build OpenH264, FFmpeg and PyAV in a separate build stage,
# because this way Docker can do it in parallel to all the other packages.
FROM build-image-base AS build-image-av

# Compile Openh264 and FFmpeg
ARG PREFIX=/opt/ffmpeg
ARG PKG_CONFIG_PATH=${PREFIX}/lib/pkgconfig
ARG MAKE_JOBS=5

ENV FFMPEG_VERSION=8.0 \
    OPENH264_VERSION=2.6.0

WORKDIR /tmp/openh264
RUN curl -sL https://github.com/cisco/openh264/archive/v${OPENH264_VERSION}.tar.gz --output - | \
    tar -zx --strip-components=1 && \
    make -j${MAKE_JOBS} && make install-shared PREFIX=${PREFIX} && make clean

WORKDIR /tmp/ffmpeg
RUN curl -sL https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.gz --output - | \
    tar -zx --strip-components=1 && \
    ./configure --disable-nonfree --disable-gpl --enable-libopenh264 --enable-libmp3lame \
        --enable-shared --disable-static --disable-doc --disable-programs --prefix="${PREFIX}" && \
    make -j${MAKE_JOBS} && make install && make clean

COPY utils/dataset_manifest/requirements.txt /tmp/utils/dataset_manifest/requirements.txt

# Since we're using pip-compile-multi, each dependency can only be listed in
# one requirements file. In the case of PyAV, that should be
# `dataset_manifest/requirements.txt`. Make sure it's actually there,
# and then remove everything else.
RUN grep -q '^av==' /tmp/utils/dataset_manifest/requirements.txt
RUN sed -i '/^av==/!d' /tmp/utils/dataset_manifest/requirements.txt

RUN --mount=type=cache,target=/root/.cache/pip/http-v2 \
    python3 -m pip wheel --no-binary=av \
    -r /tmp/utils/dataset_manifest/requirements.txt \
    -w /tmp/wheelhouse

# This stage builds wheels for all dependencies (except PyAV)
FROM build-image-base AS build-image

COPY cvat/requirements/ /tmp/cvat/requirements/
COPY utils/dataset_manifest/requirements.txt /tmp/utils/dataset_manifest/requirements.txt

# Exclude av from the requirements file
RUN sed -i '/^av==/d' /tmp/utils/dataset_manifest/requirements.txt

ARG CVAT_CONFIGURATION="production"

# The lxml and xmlsec wheels must bundle compatible libxml2 versions.
RUN --mount=type=cache,target=/root/.cache/pip/http-v2 \
    DATUMARO_HEADLESS=1 python3 -m pip wheel --no-deps --only-binary lxml,xmlsec \
    -r /tmp/cvat/requirements/${CVAT_CONFIGURATION}.txt \
    -w /tmp/wheelhouse

# Upstream's stage, with its golang:1.27.2 pinned by digest (GOLANG_IMAGE above).
FROM ${GOLANG_IMAGE} AS build-smokescreen

RUN git clone --filter=blob:none --no-checkout https://github.com/stripe/smokescreen.git
RUN cd smokescreen && git checkout eb1ac09 && go build -o /tmp/smokescreen

FROM ${BASE_IMAGE}

ARG http_proxy
ARG https_proxy
ARG no_proxy
ARG socks_proxy
ARG TZ="Etc/UTC"

ENV TERM=xterm \
    http_proxy=${http_proxy}   \
    https_proxy=${https_proxy} \
    no_proxy=${no_proxy} \
    socks_proxy=${socks_proxy} \
    LANG='C.UTF-8'  \
    LC_ALL='C.UTF-8' \
    TZ=${TZ}

ARG USER="django"
ARG CVAT_CONFIGURATION="production"
ENV DJANGO_SETTINGS_MODULE="cvat.settings.${CVAT_CONFIGURATION}"

# Install necessary apt packages
# Differences from upstream's list: unrar is in Debian's non-free component, which is enabled
# for it (and for libclamunrar below); libldap-2.5-0 is Debian's libldap2; libpython3.12t64,
# python3 and python3-venv are left out, the base provides Python 3.12 with venv. Debian's
# supervisor runs on Debian's own python3, so that package brings Python 3.11 as a second
# interpreter in /usr/bin; it runs supervisord only. Every program CVAT starts finds the venv's
# Python 3.12 first on PATH (build-server.sh checks this).
RUN sed -i 's/^Components: main$/Components: main non-free/' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get --no-install-recommends install -yq \
        adduser \
        bzip2 \
        ca-certificates \
        curl \
        git \
        libgl1 \
        libgomp1 \
        libldap-2.5-0 \
        libmp3lame0 \
        libsasl2-2 \
        nginx \
        p7zip-full \
        poppler-utils \
        supervisor \
        tzdata \
        unrar \
        wait-for-it \
    && ln -fs /usr/share/zoneinfo/${TZ} /etc/localtime && \
    dpkg-reconfigure -f noninteractive tzdata && \
    rm -rf /var/lib/apt/lists/*

# Install smokescreen
COPY --from=build-smokescreen /tmp/smokescreen /usr/local/bin/smokescreen

# Add a non-root user
# Debian has no ubuntu user to delete. Debian's adduser also puts a new user in the users group;
# the user leaves it, to have only its own group as in upstream's image.
ENV USER=${USER}
RUN adduser --uid=1000 --shell /bin/bash --disabled-password --gecos "" ${USER} && \
    if id -nG "${USER}" | grep -qw users; then deluser "${USER}" users; fi
ENV CVAT_BASE_DIR=/home/${USER}

ARG CLAM_AV="no"
RUN if [ "$CLAM_AV" = "yes" ]; then \
        apt-get update && \
        apt-get --no-install-recommends install -yq \
            clamav \
            libclamunrar && \
        sed -i 's/ReceiveTimeout 30/ReceiveTimeout 300/g' /etc/clamav/freshclam.conf && \
        freshclam && \
        chown -R ${USER}:${USER} /var/lib/clamav && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# The apt sources go back to upstream's main component only, now that unrar and libclamunrar
# are installed: nothing later in the image comes from non-free.
RUN sed -i 's/^Components: main non-free$/Components: main/' /etc/apt/sources.list.d/debian.sources

# Install wheels from the build image
# The venv is made from the base's Python 3.12, named in full: Debian's python3 is 3.11.
RUN /usr/local/bin/python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
ARG PIP_DISABLE_PIP_VERSION_CHECK=1

RUN --mount=type=bind,from=build-image,source=/tmp/wheelhouse,target=/mnt/wheelhouse \
    --mount=type=bind,from=build-image-av,source=/tmp/wheelhouse,target=/mnt/wheelhouse-av \
    python -m pip install --no-index /mnt/wheelhouse/*.whl /mnt/wheelhouse-av/*.whl

ENV NUMPROCS=1
COPY --from=build-image-av /opt/ffmpeg/lib /usr/lib

# These variables are required for supervisord substitutions in files
# This library allows remote python debugging with VS Code
ARG CVAT_DEBUG_ENABLED
RUN if [ "${CVAT_DEBUG_ENABLED}" = 'yes' ]; then \
        python3 -m pip install --no-cache-dir debugpy; \
    fi

# Removing pip due to security reasons. See: https://scout.docker.com/vulnerabilities/id/CVE-2018-20225
# The vulnerability is dubious and we don't use pip at runtime, but some vulnerability scanners mark it as a high vulnerability,
# and it was decided to remove pip from the final image
# The base's own pip under /usr/local goes too: upstream's image has no pip outside the venv.
RUN python -m pip uninstall -y pip && \
    /usr/local/bin/python3 -m pip uninstall -y pip

# Install and initialize CVAT, copy all necessary files
COPY cvat/nginx.conf /etc/nginx/nginx.conf
# Upstream's COPY --parents of the same paths, one COPY each, to the same places under /opt/cvat.
COPY backend_entrypoint.d /opt/cvat/backend_entrypoint.d/
COPY cvat /opt/cvat/cvat/
COPY supervisord /opt/cvat/supervisord/
COPY utils /opt/cvat/utils/
COPY backend_entrypoint.sh manage.py rqscheduler.py wait_for_deps.sh /opt/cvat/
COPY components/analytics/clickhouse/init.py /opt/cvat/components/analytics/clickhouse/init.py

RUN python -m compileall -q /opt/cvat

# Link manage.py to the home directory for backwards compatibility.
RUN ln -s /opt/cvat/manage.py ${CVAT_BASE_DIR}/manage.py

RUN echo "/opt/cvat" > /opt/venv/lib/python3.12/site-packages/cvat.pth

ARG COVERAGE_PROCESS_START
RUN if [ "${COVERAGE_PROCESS_START}" ]; then \
        echo "import coverage; coverage.process_startup()" > /opt/venv/lib/python3.12/site-packages/coverage_subprocess.pth; \
    fi

# RUN all commands below as 'django' user.
# Use numeric UID/GID so that the image is compatible with the Kubernetes runAsNonRoot setting.
USER 1000:1000
WORKDIR ${CVAT_BASE_DIR}

RUN mkdir -p data share keys logs /tmp/supervisord /tmp/cvat static

EXPOSE 8080
ENTRYPOINT ["/opt/cvat/backend_entrypoint.sh"]
